# 배포 서버용. `cp .env.prod.example .env` 로 복사해 값을 채운다(.env 는 git 에 올리지 않는다). 로컬은 .env 없이 쓴다.
# 자세한 설명은 README "컨테이너로 실행 (배포)". 값에 $ 가 있으면 $$ 로 쓴다.

# 서버(app)까지 compose 대상에 포함
COMPOSE_PROFILES=app

# DB·Redis 재시작 정책(app 은 항상 unless-stopped)
CIS_RESTART=unless-stopped

# DB 비밀번호. 꼭 바꾼다. DB 볼륨을 처음 만들 때만 반영된다
CIS_DB_PASSWORD=change-me

# 서버 이미지 태그(docker build -t crane-integrated-server:<tag> .)
CIS_APP_TAG=latest

# app 컨테이너 메모리 상한(JVM 힙은 이 값의 75%)
CIS_APP_MEMORY=1g

# Kafka 주소와 브로커가 있는 외부 Docker 네트워크(미리 있어야 한다)
CIS_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
CIS_KAFKA_NETWORK=isl-infra

# 호스트 포트. DB·Redis 는 127.0.0.1 에만 열린다
CIS_DB_PORT=5432
CIS_REDIS_PORT=6379
CIS_APP_PORT=8080
